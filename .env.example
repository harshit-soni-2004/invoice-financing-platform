# Copy to .env and replace every placeholder before running `docker compose up`.
# .env is git-ignored. Never commit real credentials.
# Use letters, digits, '-' and '_' only in passwords (they are interpolated into SQL by the MySQL init script).

COMPOSE_PROJECT_NAME=invoice-financing

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=replace-me-root
# Host port only (containers always use mysql:3306). 3307 avoids clashing with a locally installed MySQL.
MYSQL_PORT=3307

# One database user per service (each user can only access its own database)
AUTH_DB_PASSWORD=replace-me-auth
INVOICE_DB_PASSWORD=replace-me-invoice
FINANCING_DB_PASSWORD=replace-me-financing
NOTIFICATION_DB_PASSWORD=replace-me-notification
# audit-service: migrator owns DDL, runtime user may only SELECT/INSERT (append-only)
AUDIT_DB_MIGRATOR_PASSWORD=replace-me-audit-migrator
AUDIT_DB_PASSWORD=replace-me-audit

# ---- RabbitMQ ----
RABBITMQ_USER=ifp
RABBITMQ_PASSWORD=replace-me-rabbit
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Redis ----
REDIS_PASSWORD=replace-me-redis
REDIS_PORT=6379

# ---- MailHog (local email sink, no real email is sent) ----
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---- auth-service (token issuer) ----
# Browser-visible issuer URL; every service and the gateway expect exactly this `iss`.
AUTH_ISSUER_URI=http://localhost:9000
AUTH_AUDIENCE=ifp-api
AUTH_ACCESS_TOKEN_TTL=15m
# Development key: run scripts/generate-dev-jwt-key.ps1 (or .sh). infra/keys/ is git-ignored.
# Relative paths resolve against the directory the service is started from (the repository root here).
AUTH_JWT_PRIVATE_KEY_LOCATION=file:./infra/keys/jwt-signing-key.pem
AUTH_SPA_REDIRECT_URIS=http://localhost:4200/auth/callback
AUTH_SPA_ALLOWED_ORIGINS=http://localhost:4200
# Optional first administrator, created only if no ADMIN exists. Leave commented unless provisioning one.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.test
# ADMIN_BOOTSTRAP_PASSWORD=replace-me-at-least-12-characters
# ADMIN_BOOTSTRAP_DISPLAY_NAME=Platform Admin

# ---- gateway ----
AUTH_JWK_SET_URI=http://localhost:9000/oauth2/jwks
AUTH_SERVICE_URI=http://localhost:9000
INVOICE_SERVICE_URI=http://localhost:8081
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:4200
# Number of reverse proxies in front of the gateway whose X-Forwarded-For is trusted (0 = use the TCP peer address).
GATEWAY_TRUSTED_PROXY_HOPS=0
# Token buckets: replenish-rate tokens/second up to burst-capacity; each request costs requested-tokens.
# Registration (per client address): bursts of 5, then 5 per minute. Fails closed if Redis is unavailable.
RATE_LIMIT_PUBLIC_REPLENISH_RATE=1
RATE_LIMIT_PUBLIC_BURST_CAPACITY=60
RATE_LIMIT_PUBLIC_REQUESTED_TOKENS=12
# Authenticated APIs (per user): bursts of 40, then 20 per second. Fails open if Redis is unavailable.
RATE_LIMIT_API_REPLENISH_RATE=20
RATE_LIMIT_API_BURST_CAPACITY=40
RATE_LIMIT_API_REQUESTED_TOKENS=1
