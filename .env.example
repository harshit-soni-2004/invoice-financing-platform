# Copy to .env and replace every placeholder before running `docker compose up`.
# .env is git-ignored. Never commit real credentials.
# Use letters, digits, '-' and '_' only in passwords (they are interpolated into SQL by the MySQL init script).

COMPOSE_PROJECT_NAME=invoice-financing

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=replace-me-root
# Host port only (containers always use mysql:3306). 3307 avoids clashing with a locally installed MySQL.
MYSQL_PORT=3307

# One database user per service (each user can only access its own database)
AUTH_DB_PASSWORD=replace-me-auth
INVOICE_DB_PASSWORD=replace-me-invoice
FINANCING_DB_PASSWORD=replace-me-financing
NOTIFICATION_DB_PASSWORD=replace-me-notification
# audit-service: migrator owns DDL, runtime user may only SELECT/INSERT (append-only)
AUDIT_DB_MIGRATOR_PASSWORD=replace-me-audit-migrator
AUDIT_DB_PASSWORD=replace-me-audit

# ---- RabbitMQ ----
RABBITMQ_USER=ifp
RABBITMQ_PASSWORD=replace-me-rabbit
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Redis ----
REDIS_PASSWORD=replace-me-redis
REDIS_PORT=6379

# ---- MailHog (local email sink, no real email is sent) ----
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
